# ==============================================================================
# CGNAT AI Threat Shield & Lawful Interception Assistant
# Environment Configuration Template (.env)
# ==============================================================================

# ISP & Infrastructure
ISP_NAME="Enterprise ISP Network"
ROUTER_IPS="192.0.2.1,198.51.100.1"
ISP_PUBLIC_POOLS="203.0.113.0/24"
CGNAT_POOLS="100.64.0.0/10"

# ClickHouse Log Storage
CLICKHOUSE_HOST="127.0.0.1"
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB="nat_logs"
CLICKHOUSE_USER="default"
CLICKHOUSE_PASSWORD="your_clickhouse_password"

# Google Gemini AI Inference
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# Discord Webhook Notification Alerts
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/your/webhook/url"

# API & Web Console
API_HOST="0.0.0.0"
API_PORT=8088
SERVER_TIMEZONE="Asia/Kathmandu"

# Threat Shield Thresholds
SCAN_INTERVAL_SECONDS=300
PORT_EXHAUSTION_THRESHOLD=45000
PRIVATE_IP_FLOW_THRESHOLD=2500
PRIVATE_IP_TARGET_THRESHOLD=400
